# LiveKit Voice SFU Server Settings (Free LiveKit Cloud tier or local LiveKit SFU)
# Get free keys in 1 minute from https://cloud.livekit.io
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=wss://demo.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://demo.livekit.cloud

# Supabase PostgreSQL (Free tier — stores voice rooms / junctions)
# 1. Create a project at https://supabase.com
# 2. Go to Settings → API to get these values
# 3. Run supabase-schema.sql in the SQL Editor
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
